{
  "name": "dbx-json-grid",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && node scripts/notices.mjs && vite build",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && vitest run && node scripts/notices.mjs && vite build && node scripts/check-package.mjs",
    "package": "npm run build && dbx-plugin package . --target universal",
    "dbx:dev": "dbx-plugin dev --path . --port 5190",
    "test:browser": "playwright test",
    "release:metadata": "node scripts/release-metadata.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "lossless-json": "^4.3.3",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@dbx-app/plugin-cli": "^0.1.10",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryn-Mic/dbx-json-grid.git"
  },
  "bugs": {
    "url": "https://github.com/Ryn-Mic/dbx-json-grid/issues"
  }
}
